-- 1. 데이터베이스(저장소) 생성
CREATE DATABASE IF NOT EXISTS dongeui_civil_db;
USE dongeui_civil_db;

-- 2. 회원 테이블
CREATE TABLE member (
    member_id INT AUTO_INCREMENT PRIMARY KEY, -- 회원 고유 번호 (자동 증가)
    student_id VARCHAR(20) NOT NULL UNIQUE,   -- 학번 또는 사번
    password VARCHAR(255) NOT NULL,           -- 비밀번호
    name VARCHAR(50) NOT NULL,                -- 이름
    role VARCHAR(20) NOT NULL                 -- 권한 (STUDENT 또는 ADMIN)
);

-- 3. 민원 접수 테이블
CREATE TABLE complaint (
    complaint_id INT AUTO_INCREMENT PRIMARY KEY, -- 민원 고유 번호 (자동 증가)
    title VARCHAR(100) NOT NULL,                 -- 민원 제목
    content TEXT NOT NULL,                       -- 민원 상세 내용
    category VARCHAR(50) NOT NULL,               -- 카테고리 (예: 강의실, 화장실, 전자기기 등)
    file_path VARCHAR(255),                      -- 첨부된 사진/파일 저장 경로
    status VARCHAR(20) DEFAULT '접수대기',       -- 처리 상태 (접수대기, 처리중, 완료 등)
    sympathy_count INT DEFAULT 0,                -- '고쳐줘요' 공감 수 (성능을 위해 추가)
    member_id INT,                               -- 작성한 학생의 번호 (누가 썼는지 연결)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 작성일시
    FOREIGN KEY (member_id) REFERENCES member(member_id)
);

-- 4. '고쳐줘요' 공감 테이블
CREATE TABLE sympathy (
    sympathy_id INT AUTO_INCREMENT PRIMARY KEY, -- 공감 고유 번호
    member_id INT,                              -- 공감을 누른 회원 번호
    complaint_id INT,                           -- 공감을 받은 민원 번호
    FOREIGN KEY (member_id) REFERENCES member(member_id),
    FOREIGN KEY (complaint_id) REFERENCES complaint(complaint_id)
);

-- 5. 관리자 답변 테이블
CREATE TABLE answer (
    answer_id INT AUTO_INCREMENT PRIMARY KEY,   -- 답변 고유 번호
    complaint_id INT,                           -- 어떤 민원에 대한 답변인지 연결
    admin_id INT,                               -- 답변을 작성한 관리자 회원 번호
    content TEXT NOT NULL,                      -- 답변 내용
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 답변 등록일시
    FOREIGN KEY (complaint_id) REFERENCES complaint(complaint_id),
    FOREIGN KEY (admin_id) REFERENCES member(member_id)
);
